# PostgreSQL connection string (on Neon: the pooled connection string)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/fleet_manager?schema=public"
# Direct connection for migrations (on Neon: the connection string with pooling turned off). Locally, same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/fleet_manager?schema=public"

# Used only by `npm run db:seed` to create the first owner PIN (6 digits)
SEED_OWNER_PIN="123456"

# Set to 1 to seed sample vehicles, drivers and trips for trying the app locally
SEED_SAMPLE_DATA="0"
